# Copy your existing private .env from your LavaLust project into this folder.
# Keep passwords/secrets out of the React frontend. Do NOT commit this file as .env.
APP_NAME=Calapan BPLO Student Project
APP_ENV=development
APP_KEY=GENERATE_AN_APP_KEY

DB_HOST=your-aiven-mysql-host
DB_PORT=your-aiven-port
DB_USERNAME=your-aiven-user
DB_PASSWORD=your-private-password
DB_NAME=your-aiven-database
# ca.pem is an Aiven CA CERTIFICATE, not a client private key.
DB_SSL_CA=ca.pem
ALLOW_ORIGIN=https://web-final-frontend-cvnz.onrender.com,http://localhost:5173,http://localhost:4173
# For a separate Render frontend, set ALLOW_ORIGIN to its exact HTTPS origin.
# Outgoing email for inspection schedules and automatic fee-assessment notices
MAIL_TRANSPORT=smtp
# On free Render, use MAIL_TRANSPORT=brevo and a Brevo API key instead of SMTP ports.
# BREVO_API_KEY=your-private-brevo-api-key
BPLO_EMAIL_ENABLED=1
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-private-smtp-password
SMTP_FROM_EMAIL=your-verified-sender@example.com
SMTP_FROM_NAME="Calapan City BPLO"
# Automatic SMS for applications, inspections and fee assessments (TextBee gateway)
BPLO_SMS_ENABLED=0
TEXTBEE_API_KEY=your-private-textbee-api-key
TEXTBEE_DEVICE_ID=your-registered-android-device-id
# Optional generic LavaLust JWT helpers; BPLO uses database-backed bearer sessions.
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
REFRESH_TOKEN_KEY=GENERATE_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARS
